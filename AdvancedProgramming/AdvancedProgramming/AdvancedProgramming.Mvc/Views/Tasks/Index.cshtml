@model IEnumerable<AdvancedProgramming.Data.Tasks>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Priority)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ScheduledAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FinishedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Users.FullName)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Description)
        </td>
        <td>
            @{
                string prioridadBadge = item.Priority == "High" ? "bg-danger" :
                                        item.Priority == "Medium" ? "bg-warning text-dark" :
                                        item.Priority == "Low" ? "bg-success" : "bg-secondary";
            }
            <span class="badge @prioridadBadge">
                @item.Priority
            </span>
        </td>
        <td>
            @{
                string badgeClass = item.Status == "Pending" ? "bg-warning text-dark" :
                                    item.Status == "Completed" ? "bg-success" :
                                    item.Status == "Failed" ? "bg-danger" : "bg-secondary";
            }
            <span class="badge @badgeClass">
                @item.Status
            </span>
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CreatedAt)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ScheduledAt)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FinishedAt)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Users.FullName)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
